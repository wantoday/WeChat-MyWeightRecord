/* 分段控件 */
.seg {
  display: flex;
  background: #ebebf0;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 10rpx;
}

.seg-item.is-active {
  background: #fff;
  color: var(--text);
  font-weight: 500;
}

/* 与普通卡片一致的水平内边距：让 canvas 块和下方统计卡的内容宽度对齐 */
.chart-card {
  padding: 16rpx 32rpx;
}

/* 高度写死，脚本据此按 dpr 设置位图尺寸；改这里要同步确认图表内边距够用 */
.chart-canvas {
  width: 100%;
  height: 440rpx;
}

.chart-canvas.is-hidden {
  height: 0;
}

.stats {
  display: flex;
  justify-content: space-between;
  /* 与上方图表绘图区对齐：图表 PADDING 为 left 40px / right 16px（见 utils/chart.ts）。
     用 px 而非 rpx，因为 canvas 尺寸按 CSS px 计算，px 才能跨屏精确对齐 */
  padding: 0 16px 0 40px;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 500;
}

.stat-value.is-down {
  color: var(--brand);
}

.stat-value.is-up {
  color: #ff9500;
}

.stat-key {
  font-size: 22rpx;
  color: var(--text-sub);
}
