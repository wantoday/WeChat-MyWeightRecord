/* 分段控件 */
.seg {
  display: flex;
  background: #ebebf0;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 10rpx;
}

.seg-item.is-active {
  background: #fff;
  color: var(--text);
  font-weight: 500;
}

/* 与普通卡片一致的水平内边距：让 canvas 块和下方统计卡的内容宽度对齐 */
.chart-card {
  padding: 16rpx 32rpx;
}

/* 高度写死，脚本据此按 dpr 设置位图尺寸；改这里要同步确认图表内边距够用 */
.chart-canvas {
  width: 100%;
  height: 440rpx;
}

.chart-canvas.is-hidden {
  height: 0;
}

.stats {
  display: flex;
  justify-content: space-between;
  /* 与上方图表绘图区对齐：图表 PADDING 为 left 40px / right 16px（见 utils/chart.ts）。
     用 px 而非 rpx，因为 canvas 尺寸按 CSS px 计算，px 才能跨屏精确对齐 */
  padding: 0 16px 0 40px;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 500;
}

.stat-value.is-down {
  color: var(--brand);
}

.stat-value.is-up {
  color: #ff9500;
}

.stat-key {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 好友对比图例 */
.legend {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.legend-item {
  display: flex;
  align-items: center;
  height: 56rpx;
  font-size: 26rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex: none;
}

.legend-name {
  flex: 1;
  color: var(--text);
  /* 昵称可能很长，超出的部分截断，别把右侧数值挤出去 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-value {
  width: 120rpx;
  text-align: right;
  color: var(--text);
}

.legend-delta {
  width: 120rpx;
  text-align: right;
  color: var(--text-sub);
}

.legend-delta.is-down {
  color: var(--brand);
}

.legend-delta.is-up {
  color: #ff9500;
}

.legend-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  padding-top: 8rpx;
}

/* 与「我的」页一致的卡片底部说明文案 */
.range-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.6;
  padding-top: 8rpx;
}
