<view class="page-pad">

  <!-- 录入卡片 -->
  <view class="card entry">
    <!-- 日期选择：默认今天，可改到历史日期补登记（picker end 限制今天，禁未来） -->
    <picker mode="date" value="{{date}}" end="{{maxDate}}" bindchange="onDateChange">
      <view class="date-picker">
        <text class="date-picker-label">{{dateLabel}}的体重</text>
        <text class="date-picker-hint">{{dateHint}}</text>
      </view>
    </picker>

    <view class="entry-input">
      <input
        class="weight-field"
        type="digit"
        placeholder="0.0"
        value="{{input}}"
        bindinput="onInput"
        confirm-type="done"
        bindconfirm="onSave"
      />
      <text class="unit">{{unitLabel}}</text>
    </view>

    <!-- 单位切换：默认斤，可切 kg；存储统一 kg，仅录入/展示换算 -->
    <view class="unit-seg">
      <view
        class="unit-seg-item {{unit === 'jin' ? 'is-active' : ''}}"
        data-unit="jin"
        bindtap="onUnitTap"
      >斤</view>
      <view
        class="unit-seg-item {{unit === 'kg' ? 'is-active' : ''}}"
        data-unit="kg"
        bindtap="onUnitTap"
      >kg</view>
    </view>

    <view class="delta" wx:if="{{deltaText}}">{{deltaText}}</view>

    <view
      class="btn-primary {{saving ? 'is-disabled' : ''}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : (savedWeight ? '更新记录' : '打卡')}}</view>
  </view>

  <!-- BMI -->
  <view class="card" wx:if="{{bmi}}">
    <view class="card-title">BMI</view>
    <view class="bmi-line">
      <text class="bmi-value" style="color:{{bmi.color}}">{{bmi.value}}</text>
      <text class="bmi-label" style="background:{{bmi.color}}">{{bmi.label}}</text>
    </view>
  </view>

  <!-- 未填身高时引导 -->
  <view class="card tip" wx:elif="{{!loading && !heightCm}}" bindtap="goProfile">
    <text>填写身高后可查看 BMI ›</text>
  </view>

  <!-- 目标进度 -->
  <view class="card" wx:if="{{targetWeight}}">
    <view class="card-title">目标 {{targetText}}</view>
    <view class="bar">
      <view class="bar-fill" style="width:{{progress}}%"></view>
    </view>
    <view class="bar-pct">{{progress}}%</view>
  </view>

</view>
